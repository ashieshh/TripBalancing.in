# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: The URL of your Supabase project (client-accessible)
VITE_SUPABASE_URL=""

# SUPABASE_ANON_KEY: The anonymous key for your Supabase project (client-accessible)
VITE_SUPABASE_ANON_KEY=""

# Razorpay Payment Gateway Credentials (Server-side)
# Get these from your Razorpay Dashboard (Settings -> API Keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
VITE_RAZORPAY_KEY_ID=""

# Review notifications are sent here whenever a signed-in traveler submits a review.
# If omitted, the server falls back to ADMIN_EMAIL, SMTP_REPLY_TO, then BREVO_SMTP_USER.
REVIEW_NOTIFICATION_EMAIL=""

# Brevo delivery: configure either the HTTPS API key (recommended on Render)
# or both SMTP credentials. Never put an API key in BREVO_SMTP_PASS.
BREVO_API_KEY=""
BREVO_SMTP_USER=""
BREVO_SMTP_PASS=""
SMTP_FROM="TripBalancing <noreply@tripbalancing.in>"
SMTP_REPLY_TO="support@tripbalancing.in"
